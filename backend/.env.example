# Copia este archivo como .env
# En local se usa SQLite (archivo backend/studyhub.db, no necesita Docker)
DATABASE_URL=sqlite:///./studyhub.db
# Para la entrega con PostgreSQL (docker compose up -d), usa en su lugar:
# DATABASE_URL=postgresql+psycopg://studyhub:studyhub@localhost:5432/studyhub
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_MINUTES=1440
FRONTEND_URL=http://localhost:3000
# En desarrollo el código de verificación se muestra en la consola y en la respuesta
DEBUG=true
